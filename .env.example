# ==============================================================================
# SecureChat Environment Variables Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Server Ports & Networking
FRONTEND_PORT=5173
BACKEND_PORT=3000
CORS_ORIGIN=*
DOCKER_NETWORK=cloudflared

# Security & HTTPS Configuration
USE_HTTPS=true
SSL_CERT_PATH=certs/server.crt
SSL_KEY_PATH=certs/server.key

# Key Derivation Settings (Cryptographic Parameters)
KEY_DERIVATION_ITERATIONS=10000
KEY_DERIVATION_SALT=securechat-default-salt-change-in-production

# Vite Frontend Environment Variables
VITE_KEY_DERIVATION_SALT=securechat-default-salt-change-in-production
VITE_KEY_DERIVATION_ITERATIONS=10000
VITE_MAX_QUEUE_SIZE=50
VITE_MAX_MESSAGES_PER_MINUTE=30

# WebRTC STUN / TURN Relay Server Credentials
TURN_SERVER_URL=turn:your-turn-server.example.com:443
TURN_USERNAME=your_turn_username
TURN_PASSWORD=your_turn_password

# Remote Server Deployment Configuration (Supports SERVER_* or legacy PI_* keys)
SERVER_HOST=server.example.com
SERVER_USER=deploy
SERVER_PATH=~/securechat
SERVER_PORT=22
SERVER_SSH_KEY=~/.ssh/id_ed25519
